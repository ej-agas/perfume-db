FROM golang:1.22-alpine3.19 AS builder

RUN /sbin/apk update && \
	/sbin/apk --no-cache add ca-certificates git tzdata && \
	/usr/sbin/update-ca-certificates

RUN adduser -D -g '' perfume_db_user
WORKDIR /home/perfume_db_user

COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cmd ./cmd
COPY internal ./internal
COPY postgresql ./postgresql

# Create necessary directories
RUN mkdir -p /home/perfume_db_user/templates \
    && mkdir -p /home/perfume_db_user/static/css \
    && chown -R perfume_db_user:perfume_db_user /home/perfume_db_user

# Copy templates and static files with correct permissions
COPY --chown=perfume_db_user:perfume_db_user templates/ /home/perfume_db_user/templates/
COPY --chown=perfume_db_user:perfume_db_user static/ /home/perfume_db_user/static/

# Copy the rest of the application
COPY . .

ARG VERSION

ENV CGO_ENABLED=0
ENV DOCKER_BUILDKIT=1

RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -buildvcs=false -o perfume_db_app ./cmd/perfume-db

FROM busybox:musl

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /home/perfume_db_user/perfume_db_app /home/perfume_db_user

USER perfume_db_user
WORKDIR /home

ENTRYPOINT ["/home/perfume_db_user"]