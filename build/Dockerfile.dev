FROM golang:1.24-alpine3.22 AS builder

# Install build dependencies
RUN apk add --no-cache git

# Set working directory
WORKDIR /app

# Copy go mod files first for better caching
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
ARG VERSION
ENV CGO_ENABLED=0
ENV DOCKER_BUILDKIT=1

RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -buildvcs=false -o /app/perfume_db_app ./cmd/perfume-db

# Final stage
FROM alpine:3.22

# Create non-root user and set up directories
RUN adduser -D -u 1000 -g '' perfume_db_user && \
    mkdir -p /home/perfume_db_user/static/css /home/perfume_db_user/templates && \
    chown -R perfume_db_user:perfume_db_user /home/perfume_db_user

# Install CA certificates
RUN apk add --no-cache ca-certificates

# Copy the binary from builder
COPY --from=builder /app/perfume_db_app /home/perfume_db_user/

# Create directories and set permissions
RUN mkdir -p /home/perfume_db_user/{static/css,templates} && \
    chown -R perfume_db_user:perfume_db_user /home/perfume_db_user

# Copy templates and static files
COPY --chown=perfume_db_user:perfume_db_user templates/ /home/perfume_db_user/templates/
COPY --chown=perfume_db_user:perfume_db_user static/ /home/perfume_db_user/static/

# Switch to non-root user
USER perfume_db_user
WORKDIR /home/perfume_db_user

# Expose port
EXPOSE 4000

# Run the application
ENTRYPOINT ["/home/perfume_db_user/perfume_db_app"]